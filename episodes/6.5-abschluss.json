{"id":"6.5-abschluss","title":"6.5 Entstehung eines Gesetzes – Abschluss","audio":"../allgemeinbildung/audio/6.5%20Entstehung%20eines%20Gesetzes.wav","duration":430.931,"map":{"root":"Entstehung eines Gesetzes","branches":[{"label":"Phase 1: Anstoss & Vorentwurf","color":"blue","nodes":[{"id":"Anstoss","label":"Anstoss"},{"id":"Vorentwurf","label":"Vorentwurf"}]},{"label":"Phase 2: Vernehmlassung & definitive Vorlage","color":"green","nodes":[{"id":"Vernehmlassung","label":"Vernehmlassung"},{"id":"Definitiver Entwurf mit Botschaft","label":"Definitiver Entwurf mit Botschaft"}]},{"label":"Phase 3: Parlamentarische Behandlung","color":"red","nodes":[{"id":"Behandlung im Nationalrat","label":"Behandlung im Nationalrat"},{"id":"Behandlung im Ständerat","label":"Behandlung im Ständerat"},{"id":"Differenzbereinigungsverfahren","label":"Differenzbereinigungsverfahren"}]},{"label":"Phase 4: Referendum & Inkrafttreten","color":"yellow","nodes":[{"id":"Veröffentlichung & Referendumsfrist","label":"Veröffentlichung & Referendumsfrist"},{"id":"Volksabstimmung (falls Referendum)","label":"Volksabstimmung (falls Referendum)"},{"id":"Inkrafttreten","label":"Inkrafttreten"}]}]},"chapters":[{"title":"Einstieg","shots":[{"at":0,"tpl":"statement","lines":[{"style":"small","text":"Kapitel 6.5 · Abschluss"},{"style":"big","text":"Entstehung eines Gesetzes"},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":2.08},{"style":"strip","color":"yellow","text":"Nehmen Sie Ihre Mindmap hervor!","at":20.84}]},{"at":34.24,"tpl":"statement","head":"Akteure im Gesetzgebungsprozess","lines":[{"style":"chip","color":"blue","text":"Bundesrat","at":35.82},{"style":"chip","color":"blue","text":"Parlament","at":37.16},{"style":"chip","color":"blue","text":"Kantone","at":39.42},{"style":"chip","text":"Parteien","at":40.22},{"style":"chip","text":"Verbände","at":40.92}]}]},{"title":"Anstoss & Vorentwurf","shots":[{"at":71.78,"tpl":"map","node":"Anstoss","branchAt"