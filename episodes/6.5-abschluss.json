"text":"kleinere Gruppen in National- und Ständerat","at":218.8},{"text":"danach entscheiden die beiden Räte im Plenum","at":226.96},{"text":"über jeden einzelnen Artikel","at":232.18}]},{"at":248.98,"tpl":"map","branch":"Phase 3: Parlamentarische Behandlung","title":"Differenzbereinigungsverfahren","titleAt":255.42,"lead":{"text":"Räte nicht einig?","at":249.98},"facts":[{"text":"kommt relativ häufig vor","at":256.02},{"text":"der Entwurf geht zwischen den Räten hin und her","at":260.14},{"text":"bis man sich bei den strittigen Punkten geeinigt hat","at":262.86},{"text":"ohne Kompromiss kann das Gesetz scheitern","at":272.26}],"note":{"text":"möglicher Schritt nach Ratsbehandlung","at":277.2}}]},{"title":"Referendum & Inkrafttreten","shots":[{"at":282.96,"tpl":"map","node":"Veröffentlichung & Referendumsfrist","branchAt":286.22,"title":"Veröffentlichung & Referendumsfrist","titleAt":286.22,"lead":{"text":"Tritt es dann in Kraft?","at":283.96},"facts":[{"text":"vom Parlament beschlossen, aber noch nicht in Kraft","at":289.22},{"text":"zuerst Veröffentlichung im Bundesblatt","at":293.02},{"text":"das offizielle Publikationsorgan","at":295.32},{"text":"damit startet die Referendumsfrist von 100 Tagen","at":300.34}]},{"at":317.4,"tpl":"map","node":"Volksabstimmung (falls Referendum)","title":"Volksabstimmung (falls Referendum)","titleAt":318.4,"facts":[{"text":"Referendum innerhalb der 100 Tage","at":319.06},{"text":"Bürgerinnen und Bürger: 50'000 gültige Unterschriften","at":321.46},{"text":"oder acht Kantone gemeinsam","at":324.94},{"text":"dann kommt es zu einer Volksabstimmung","at":330.66}]},{"at":333.54,"tpl":"map","node":"Inkrafttreten","title":"Inkrafttreten","titleAt":334.54,"facts":[{"text":"nur wenn kein Referendum zustande kommt","at":334.86},{"text":"oder wenn das Volk in der Abstimmung Ja sagt","at":338.3},{"text":"dann kann der Bundesrat das Gesetz in Kraft setzen","at":339.98}]}]},{"title":"Zusammenfassung","shots":[{"at":351.82,"tpl":"map","node":null,