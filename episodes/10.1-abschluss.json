acts":[{"text":"Verbrauchssteuer des Bundes","at":279.22},{"text":"auf fast allen Waren und Dienstleistungen","at":282.84},{"text":"Normalsatz 8,1 %","at":286.6},{"text":"2,6 %: Lebensmittel, Medikamente, Bücher","at":295.96},{"text":"3,8 %: Übernachtung im Hotel","at":303.84},{"text":"besteuert wird der Mehrwert jeder Stufe","at":311.06},{"text":"am Ende zahlt der Endkonsument","at":314.14}],"note":{"text":"bei Mehrwertsteuer ergänzen","at":317.06}}]},{"title":"Praxis","shots":[{"at":319.4,"tpl":"map","node":"erklaerung","title":"Steuererklärung","titleAt":327.04,"facts":[{"text":"Selbstdeklaration: vollständig und wahrheitsgetreu","at":331.74},{"text":"Einkommen, Vermögen, Abzüge","at":338.96},{"text":"Steuerhinterziehung ist strafbar","at":345.92},{"text":"Steuerbetrug (gefälschte Dokumente) erst recht","at":350.72},{"text":"Unterlagen: Lohnausweis, Bankauszüge, Belege","at":357.2},{"text":"Fristen beachten: sonst Mahnung, Zins, Busse","at":362.8}],"note":{"text":"Pflicht · Wahrheit · Fristen","at":372.06},"branchAt":323.22},{"at":375.92,"tpl":"map","node":"bemessung","title":"Steuerprogression","titleAt":381.58,"facts":[{"text":"höheres Einkommen oder Vermögen: höherer Steuersatz","at":385.76},{"text":"nicht nur der Betrag, auch der Anteil steigt","at":393.22},{"text":"wer viel verdient, zahlt prozentual mehr","at":397.24},{"text":"Ziel: soziale Gerechtigkeit, Umverteilung","at":405.26},{"text":"Gegenmodell: Flat Rate Tax, gleicher Satz für alle","at":409.7},{"text":"Kernmerkmal unserer Einkommenssteuer","at":415.58}]}]},{"title":"Zusammenfassung","shots":[{"at":418.82,"tpl":"map","node":null,"title":"Die Kernpunkte","titleAt":420.08,"facts":[{"text":"steuerpflichtig meist ab 18","at":424.6},{"text":"Steuern finanzieren den Staat, wirken sozial und lenkend","at":425.98},{"text":"direkt: Einkommenssteuer · indirekt: MWST","at":430.82},{"text":"Verrechnungssteuer: Geld zurück bei korrekter Angabe","at":436.38},{"text":"Steuererklärung: jährliche Pflicht","at":442.