,"tpl":"map","node":"Stufen der HandlungsUNfähigkeit","title":"Stufen der HandlungsUNfähigkeit","titleAt":314.02,"facts":[{"text":"beschränkte Handlungsunfähigkeit","at":314.32},{"text":"urteilsfähig, aber noch nicht volljährig","at":320.12},{"text":"geregelt in ZGB Art. 19","at":326.14}]},{"at":326.98,"tpl":"map","node":"Stufen der HandlungsUNfähigkeit","sub":true,"title":"Beschränkte Handlungsunfähigkeit","titleAt":327.76,"lead":{"text":"Was darf ich schon?","at":327.58},"facts":[{"text":"über Taschengeld und Lohn frei verfügen: ZGB Art. 323","at":331.34},{"text":"grössere Verpflichtungen, z. B. Lehrvertrag oder Mofa","at":341.64},{"text":"brauchen die Zustimmung der gesetzlichen Vertreter","at":345.88},{"text":"Ausnahme: höchstpersönliche Rechte","at":351.94},{"text":"z. B. Zustimmung zu einer medizinischen Behandlung","at":357.34},{"text":"wenn urteilsfähig: Eltern entscheiden nicht mehr allein","at":359.04}]}]},{"title":"Jugendalter und Rechtsfälle","shots":[{"at":365.4,"tpl":"map","node":"Rechte/Pflichten Jugendlicher","sub":true,"branchAt":366.4,"title":"Beitrag Haushalt gem. ZGB Art. 323","titleAt":376.02,"lead":{"text":"Auch Pflichten?","at":372.76},"facts":[{"text":"für Kinder, die zu Hause wohnen und schon verdienen","at":377.78},{"text":"Eltern können einen angemessenen Beitrag verlangen","at":379.86}]},{"at":387.88,"tpl":"map","node":"Methodik Rechtsfalllösung","title":"Methodik Rechtsfalllösung","titleAt":388.88,"facts":[{"text":"Drei-Schritt-Methode","at":392.94},{"text":"1. Sachverhalt genau anschauen: Was ist passiert?","at":397.24},{"text":"2. passende Gesetzesregel finden: Welcher Artikel passt?","at":402.24},{"text":"3. Regel auf den Fall anwenden, Schlussfolgerung ziehen","at":407.18}]}]},{"title":"Zusammenfassung","shots":[{"at":415.58,"tpl":"map","node":null,"title":"Die Kernpunkte","titleAt":416.58,"facts":[{"text":"Pyramide: Verfassung, Gesetz, Verordnung","at":425.64},{"text":"Gliederung in öffentliches und privates Recht","at":429.36},{"te