{"id":"6.2-abschluss","title":"6.2 Bundesstaat Schweiz – Abschluss","audio":"../allgemeinbildung/audio/6.2%20Bundesstaat%20Schweiz.wav","duration":397.691,"map":{"root":"Bundesstaat Schweiz","branches":[{"label":"Staatsformen und Föderalismus","color":"blue","nodes":[]},{"label":"Demokratie als Regierungsform","color":"green","nodes":[{"id":"Direkte Demokratie","label":"Direkte Demokratie"},{"id":"Repräsentative Demokratie","label":"Repräsentative Demokratie"},{"id":"Halbdirekte Demokratie (Schweiz)","label":"Halbdirekte Demokratie (Schweiz)"},{"id":"Konkordanzdemokratie vs. Konkurrenzdemokratie","label":"Konkordanzdemokratie vs. Konkurrenzdemokratie"}]},{"label":"Konkordanzdemokratie vs Konkurrenzdemokratie","color":"red","nodes":[]},{"label":"Abgrenzung Demokratie zur Diktatur","color":"yellow","nodes":[{"id":"Merkmale Demokratie","label":"Merkmale Demokratie"},{"id":"Merkmale Diktatur","label":"Merkmale Diktatur"}]},{"label":"Staatsformen","color":"blue","nodes":[{"id":"Bundesstaat","label":"Bundesstaat"},{"id":"Definition Föderalismus","label":"Definition Föderalismus"},{"id":"Einheitsstaat","label":"Einheitsstaat"},{"id":"Staatenbund","label":"Staatenbund"}]}]},"chapters":[{"title":"Einstieg","shots":[{"at":0,"tpl":"statement","lines":[{"style":"small","text":"Kapitel 6.2 · Abschluss"},{"style":"big","text":"Bundesstaat Schweiz"},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":1.94},{"style":"strip","color":"yellow","text":"Holt eure Mindmap hervor!","at":19.58}]}]},{"title":"Staatsformen","shots":[{"at":78.8,"tpl":"map","node":"Bundesstaat","branchAt":75.2,"title":"Bundesstaat","titleAt":79.6,"facts":[{"text":"z. B. die Schweiz","at":82.02},{"text":"die Teilstaaten, bei uns die Kantone, haben eigene Aufgaben","at":83.4},{"text":"zusammen bilden sie den Gesamtstaat","at":87.68}]},{"at":89.9,"tpl":"map","node":"Einheitsstaat","title":"Einheitsstaat","titleAt":90.7,"facts":[{"text":"alles kommt zentral von einer Regierung","at":93.94},{"text":"z. B. Frankreich","at":95.86}]},{"at":98.84,"tpl":"map","node":"Staatenbund","title":"Staatenbund","titleAt":99.64,"facts":[{"text":"unabhängige Staaten tun sich für bestimmte Zwecke zusammen","at":102.58},{"text":"etwas Ähnliches war die Schweiz vor 1848","at":107.76}]},{"at":119.98,"tpl":"map","node":"Bundesstaat","sub":true,"title":"Föderalismus in der Schweiz","titleAt":120.78,"facts":[{"text":"das Bauprinzip unseres Bundesstaates","at":124.12},{"text":"Macht und Aufgaben sind verteilt","at":126.88}]},{"at":129.24,"tpl":"map","node":"Bundesstaat","sub":true,"title":"Bundesaufgaben","titleAt":129.84,"facts":[{"text":"z. B. Armee, Aussenpolitik, Währung","at":132.5}]},{"at":137.88,"tpl":"map","node":"Bundesstaat","sub":true,"title":"Kantonsaufgaben","titleAt":138.48,"facts":[{"text":"souverän, solange die Bundesverfassung nichts anderes sagt","at":142.68},{"text":"typisch: das Schulwesen","at":149.04},{"text":"deshalb 26 Schulsysteme","at":151.02},{"text":"Gesundheitswesen, Polizei: meistens Kantonssache","at":153.92}]},{"at":158.4,"tpl":"map","node":"Bundesstaat","sub":true,"title":"Gemeindeaufgaben","titleAt":159,"facts":[{"text":"Schulhäuser bauen","at":163.94},{"text":"Feuerwehr","at":165.16},{"text":"Kehrichtabfuhr","at":165.92},{"text":"Sozialhilfe","at":167.26}]}]},{"title":"Demokratie als Regierungsform","shots":[{"at":187.86,"tpl":"map","node":"Direkte Demokratie","branchAt":182.72,"title":"Direkte Demokratie","titleAt":188.66,"facts":[{"text":"das Volk entscheidet alles selbst","at":190.26},{"text":"gibt es kaum in Reinform","at":192.9}]},{"at":194.78,"tpl":"map","node":"Repräsentative Demokratie","title":"Repräsentative Demokratie","titleAt":195.58,"facts":[{"text":"wir wählen Vertreter: ein Parlament","at":198.02},{"text":"sie entscheiden dann für uns","at":200.78},{"text":"z. B. Deutschland, USA","at":202.56}]},{"at":209.6,"tpl":"map","node":"Halbdirekte Demokratie (Schweiz)","title":"Halbdirekte Demokratie (Schweiz)","titleAt":210.4,"facts":[{"text":"eine Mischform","at":212.38},{"text":"wir wählen unser Parlament","at":214.32},{"text":"aber wir können auch direkt reinreden","at":216.86},{"text":"mit Volksinitiativen die Verfassung ändern","at":218.78},{"text":"mit dem Referendum über Gesetze abstimmen","at":222.42}]},{"at":239.58,"tpl":"map","node":"Konkordanzdemokratie vs. Konkurrenzdemokratie","title":"Konkordanzdemokratie vs. Konkurrenzdemokratie","titleAt":240.38,"facts":[{"text":"anderswo regiert eine Partei oder Koalition","at":247.8},{"text":"die anderen sind in der Opposition","at":250.68},{"text":"das wäre Konkurrenzdemokratie","at":252.36}]},{"at":255.18,"tpl":"map","node":"Konkordanzdemokratie vs. Konkurrenzdemokratie","title":"Konkordanzdemokratie vs. Konkurrenzdemokratie","titleAt":255.98,"facts":[{"text":"bei uns versucht man, alle wichtigen politischen Kräfte …","at":256.28},{"text":"… in die Regierung, also in den Bundesrat einzubinden","at":260.3},{"text":"es geht um Kompromiss und Stabilität","at":262.64},{"text":"die Opposition ist eher das Volk mit dem Referendum","at":265.36},{"text":"Volk oder Interessengruppen können Entscheide korrigieren","at":271}]}]},{"title":"Abgrenzung zur Diktatur","shots":[{"at":285.78,"tpl":"map","node":"Merkmale Demokratie","branchAt":286.78,"title":"Merkmale Demokratie","titleAt":286.78,"facts":[{"text":"Gewaltenteilung: Regierung, Parlament, Gerichte unabhängig?","at":293.5},{"text":"Menschenrechte: garantiert und geschützt?","at":299.4},{"text":"freie, faire Wahlen und Abstimmungen?","at":303.62},{"text":"Meinungs- und Pressefreiheit","at":307.26}]},{"at":315.76,"tpl":"map","node":"Merkmale Diktatur","title":"Merkmale Diktatur","titleAt":316.36,"facts":[{"text":"die Macht liegt bei wenigen oder nur einer Person","at":317.34},{"text":"keine echte Gewaltenteilung","at":320.24},{"text":"Menschenrechte werden oft missachtet","at":322.64},{"text":"Wahlen sind Schauveranstaltungen","at":325.12},{"text":"wer Kritisches sagt, riskiert viel","at":327.88}]}]},{"title":"Zusammenfassung","shots":[{"at":341.16,"tpl":"map","node":null,"title":"Die Kernpunkte","titleAt":342.16,"facts":[{"text":"Föderalismus: Bund, Kantone, Gemeinden","at":345.92},{"text":"halbdirekte Demokratie als Schweizer Modell","at":350.74},{"text":"Demokratie und Diktatur: mit klaren Kriterien abgrenzen","at":356.7}]},{"at":394.08,"tpl":"statement","lines":[{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":394.68}]}]}],"caps":[[0,3.06,[["Willkommen",0,0.38],["zu",0.38,0.54],["einer",0.54,0.72],["weiteren",0.72,1.14],["Folge",1.14,1.54],["von",1.54,1.94],["Allgemeinbildung,",1.94,3.06]]],[3.28,4.78,[["das",3.28,3.46],["Lehrmittel",3.46,3.98],["anders",3.98,4.3],["erzählt.",4.3,4.78]]],[5.08,9,[["Hallo",5.08,5.4],["zusammen.",5.4,5.86],["Heute",6.32,6.54],["schauen",6.54,6.82],["wir",6.82,6.94],["uns",6.94,7.16],["den",7.16,7.36],["Bundesstaat",7.36,8],["Schweiz",8,8.34],["genauer",8.34,8.8],["an.",8.8,9]]],[9.64,14.32,[["Also",9.64,10.24],["die",10.24,10.42],["Staatsformen,",10.42,11.2],["den",11.42,11.54],["Föderalismus",11.54,12.34],["und",12.34,12.94],["die",12.94,13.18],["Demokratie",13.18,13.74],["hier",13.74,13.88],["bei",13.88,14.02],["uns.",14.02,14.32]]],[14.58,16.06,[["Genau,",14.58,14.8],["ein",14.92,15.02],["super",15.02,15.38],["wichtiges",15.38,15.8],["Thema.",15.8,16.06]]],[16.54,20.84,[["Holt",16.54,16.72],["am",16.72,16.86],["besten",16.86,17.14],["eure",17.14,17.54],["Unterlagen",17.54,18.04],["raus,",18.04,18.4],["vor",18.78,19.28],["allem",19.28,19.42],["die",19.42,19.58],["Mindmap",19.58,20.02],["zu",20.02,20.3],["dem",20.3,20.44],["Kapitel.",20.44,20.84]]],[21.2,23.46,[["Ja,",21.2,21.52],["die",21.84,21.96],["gehen",21.96,22.14],["wir",22.14,22.26],["jetzt",22.26,22.48],["quasi",22.48,22.78],["gemeinsam",22.78,23.2],["durch.",23.2,23.46]]],[23.92,24.92,[["Dann",23.92,24.02],["seid",24.02,24.2],["ihr",24.2,24.28],["da",24.28,24.4],["sattelfest.",24.4,24.92]]],[24.92,29.04