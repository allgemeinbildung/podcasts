{"id":"5.1-abschluss","title":"5.1 Sachversicherungen – Abschluss","audio":"../allgemeinbildung/audio/5.1%20Sachversicherungen.wav","duration":399.411,"map":{"root":"Sachversicherungen","branches":[{"label":"Fahrzeugversicherungen","color":"blue","nodes":[]},{"label":"Gebäude und Hausratversicherungen","color":"green","nodes":[]},{"label":"Rechtsschutzversicherung","color":"red","nodes":[]},{"label":"Teilkaskoversicherung","color":"yellow","nodes":[]},{"label":"Vollkaskoversicherung","color":"blue","nodes":[]},{"label":"Rechtsschutzversicherung Auto","color":"green","nodes":[]},{"label":"Gebäudeversicherung","color":"red","nodes":[]},{"label":"Hausratversicherung","color":"yellow","nodes":[]},{"label":"Hausratsversicherung","color":"blue","nodes":[]},{"label":"Unterversicherung","color":"green","nodes":[]}]},"chapters":[{"title":"Einstieg","shots":[{"at":0,"tpl":"statement","lines":[{"style":"small","text":"Kapitel 5.1 · Abschluss"},{"style":"big","text":"Sachversicherungen"},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":1.76}]}]},{"title":"Teilkasko","shots":[{"at":73.5,"tpl":"map","branch":"Teilkaskoversicherung","title":"Teilkaskoversicherung","titleAt":74.1,"facts":[{"text":"deckt, was von aussen kommt","at":76.36},{"text":"Diebstahl","at":77.74},{"text":"Elementarereignisse: Hagel, Hochwasser","at":79.02},{"text":"Glasbruch, Vandalismus","at":82.22},{"text":"Kollision mit Tieren","at":84.88},{"text":"Marderbisse","at":86.54}]}]},{"title":"Vollkasko","shots":[{"at":93.64,"tpl":"map","branch":"Vollkaskoversicherung","title":"Vollkaskoversicherung","titleAt":94.52,"lead":{"text":"Was kommt noch dazu?","at":95.36},"facts":[{"text":"schliesst die Teilkasko mit ein","at":98.38},{"text":"selbstverschuldete Kollision, z. B. aus Unachtsamkeit","at":104.6},{"text":"Totalschaden (auch Teilkasko): meist nur der Zeitwert","at":116.16},{"text":"Zeitwert: Wert vor dem Unfall, nicht Neuwert","at":125},{"text":"bei älteren Autos kann die Prämie den Nutzen übersteigen","at":142.52}]}]},{"title":"Rechtsschutz","shots":[{"at":148.98,"tpl":"map","branch":"Rechtsschutzversicherung Auto","title":"Rechtsschutzversicherung Auto","titleAt":157.16,"lead":{"text":"Wenn es Streit gibt?","at":150.66},"facts":[{"text":"Gutachter, Anwaltskosten, vielleicht Gerichtskosten","at":163.04},{"text":"die Versicherung übernimmt diese Kosten","at":168.36},{"text":"Schuldfrage im Verkehr oft kompliziert","at":178.04}]}]},{"title":"Gebäude","shots":[{"at":186.46,"tpl":"map","branch":"Gebäudeversicherung","title":"Gebäudeversicherung","titleAt":187.86,"facts":[{"text":"für Eigentümer von Haus oder Wohnung","at":194.78},{"text":"in den meisten Kantonen obligatorisch","at":197.52},{"text":"deckt Schäden am Gebäude selbst","at":199.28},{"text":"Mauern, Dach, Fenster, fest installierte Leitungen","at":201.54},{"text":"Feuer, Wasser, Elementarereignisse (Sturm, Hagel)","at":207.18}]}]},{"title":"Hausrat","shots":[{"at":215.56,"tpl":"map","branch":"Hausratversicherung","title":"Hausratversicherung","titleAt":216.36,"facts":[{"text":"wichtig für Mieter und Eigentümer","at":229.76},{"text":"schützt bewegliche Sachen","at":232.76},{"text":"Möbel, Kleidung, Elektronik, Bücher","at":234.12},{"text":"Feuer, Wasser, Glasbruch","at":242.18},{"text":"Glas meist nur an Möbeln, nicht am Fenster","at":247.12}]},{"at":249.56,"tpl":"map","branch":"Hausratversicherung","sub":true,"title":"Neuwert","titleAt":251.3,"lead":{"text":"Was heisst das genau?","at":253},"facts":[{"text":"z. B. Fernseher, fünf Jahre alt, Wasserschaden","at":257.84},{"text":"Ersatz: was ein gleichwertiges neues Gerät heute kostet","at":262.52},{"text":"nicht der Wert des alten Geräts","at":269.58},{"text":"Neuwert, nicht Zeitwert wie beim Auto","at":272.54}]}]},{"title":"Unterversicherung","shots":[{"at":278.02,"tpl":"map","branch":"Unterversicherung","title":"Unterversicherung","titleAt":279.1,"lead":{"text":"Wo ist die Falle?","at":280.88},"facts":[{"text":"Gesamt