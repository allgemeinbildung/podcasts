e","text":"Lohnabrechnung","at":62.9},{"style":"chip","color":"green","text":"Kontoauszug","at":63.94}]}]},{"title":"Brutto und Netto","shots":[{"at":70.56,"tpl":"map","branch":"Bruttolohn","branchAt":71.56,"title":"Bruttolohn","titleAt":71.56,"lead":{"text":"Was ist das exakt?","at":73.56},"facts":[{"text":"bevor irgendwas abgezogen wird","at":82.4}]},{"at":86.94,"tpl":"map","branch":"Nettolohn","branchAt":87.94,"title":"Nettolohn","titleAt":87.94,"facts":[{"text":"was nach den Abzügen übrig bleibt","at":89.02}]},{"at":98.94,"tpl":"map","node":"Lohnzusätze","title":"Lohnzusätze","titleAt":99.94,"facts":[{"text":"der Bruttolohn kann höher sein als der reine Vertragslohn","at":100.34},{"text":"bezahlte Überstunden","at":102.34},{"text":"13. Monatslohn","at":105.48},{"text":"Gratifikation","at":107.22},{"text":"Naturallohn: Kost und Logis gestellt bekommen","at":111.72},{"text":"kommen zum vereinbarten Lohn dazu: zusammen der Bruttolohn","at":115.3}]}]},{"title":"Lohnabzüge","shots":[{"at":136.86,"tpl":"map","node":"Sozialversicherungsbeiträge (ab 18. LJ)","branchAt":137.86,"title":"Sozialversicherungsbeiträge (ab 18. LJ)","titleAt":143.84,"lead":{"text":"Die wichtigsten Abzüge?","at":138.96},"facts":[{"text":"AHV: Alters- und Hinterlassenenversicherung","at":151.5},{"text":"IV: Invalidenversicherung","at":155.86},{"text":"EO: Erwerbsersatzordnung","at":159.14},{"text":"ALV: Arbeitslosenversicherung","at":161.94}]},{"at":163.96,"tpl":"map","node":"Sozialversicherungsbeiträge (ab 18. LJ)","title":"Sozialversicherungsbeiträge (ab 18. LJ)","titleAt":164.56,"lead":{"text":"Wer zahlt das?","at":164.56},"facts":[{"text":"paritätisch: je zur Hälfte du und dein Arbeitgeber","at":167.7},{"text":"beitragspflichtig ab 1. Januar des Jahres, in dem du 18 wirst","at":180.28},{"text":"ein bestimmter Prozentsatz vom Bruttolohn","at":190.88},{"text":"Solidaritätsgedanke: alle tragen bei","at":194.32}]},{"at":212.52,"tpl":"map","node":"Unfallversicherung (UVG)","title":"Unfallversicherung (UVG)","titleAt":213.52,"facts":[{"text":"NBU: Nichtberufsunfallversicherung, für Freizeitunfälle","at":219.82},{"text":"die NBU-Prämie zahlst in der Regel du: Abzug vom Lohn","at":224.54},{"text":"BU: übernimmt der Arbeitgeber komplett","at":231.36},{"text":"die BU-Prämie darf dir nicht vom Lohn abgezogen werden","at":233.3}]},{"at":249.3,"tpl":"map","node":"Spezialregelungen Lernende","title":"Spezialregelungen Lernende","titleAt":257.08,"lead":{"text":"Gibt es spezielle Regeln?","at":249.7},"facts":[{"text":"Kosten, die der Lehrbetrieb tragen muss","at":263.74},{"text":"die BU-Prämie","at":266.82},{"text":"die Berufsfachschule","at":269.64},{"text":"die überbetrieblichen Kurse (üK)","at":272.12},{"text":"das Qualifikationsverfahren, deine Lehrabschlussprüfung","at":276.16},{"text":"das alles darf nicht von deinem Lohn abgehen","at":279.6}]},{"at":285.9,"tpl":"map","node":"Spezialregelungen Lernende","sub":true,"title":"Mögliche Abzüge (mit Lehrvertragsregelung)","titleAt":286.7,"facts":[{"text":"Kost und Logis, z. B. wenn du im Betrieb wohnst","at":288.34},{"text":"spezielle Berufskleidung","at":292.34},{"text":"nur wenn es klar im Lehrvertrag vereinbart ist","at":297.8}]},{"at":307.18,"tpl":"map","node":"Weitere mögliche Abzüge","title":"Weitere mögliche Abzüge","titleAt":307.98,"facts":[{"text":"BVG: Pensionskasse, berufliche Vorsorge","at":313.76},{"text":"obligatorisch ab einem bestimmten Einkommen und Alter","at":320.56},{"text":"KTG: Krankentaggeldversicherung","at":323.2},{"text":"die KTG-Prämie kann abgezogen werden, oft hälftig","at":329.06}]}]},{"title":"Ausbezahlter Lohn","shots":[{"at":335.98,"tpl":"map","branch":"Ausbezahlter Lohn","branchAt":336.98,"title":"Ausbezahlter Lohn","titleAt":336.98,"facts":[{"text":"der Betrag, der wirklich auf deinem Konto landet","at":339.22},{"text":"kann höher sein als der reine Nettolohn","at":344.02}]},{"at":346.54,"tpl":"map","node":"+ Spesenentschädigung","title":"+ Spesenentschädigung","titleAt":347.34,"facts":[{"text":"Spesen: Auslagenersatz","at":348.72}]},{"at":350.66,"tpl":"map","node":"+ Sozialzulagen (z.B. Kinder-, Familienzulage)","title":"+ Sozialzulagen (z.B. Kinder-, Familienzulage)","titleAt":351.26,"facts":[{"text":"nur falls das zutrifft","at":353.72}]}]},{"title":"Abrechnung und Kontoauszug","shots":[{"at":367.34,"tpl":"map","branch":"Lohnabrechnung","branchAt":368.34,"title":"Lohnabrechnung","titleAt":368.34,"facts":[{"text":"das Dokument, das alles zusammenfasst","at":368.74},{"text":"kommt jeden Monat","at":373.22}]},{"at":374.22,"tpl":"map","node":"Zweck (OR Art. 323b Abs. 1)","title":"Zweck (OR Art. 323b Abs. 1)","titleAt":375.02,"facts":[{"text":"Kontrolle für dich","at":377.76},{"text":"auch als Nachweis","at":379.48},{"text":"du siehst genau, wie sich dein Lohn zusammensetzt","at":382.28}]},{"at":382.86,"tpl":"map","node":"Typische Bestandteile (gem. Muster S. 47)","title":"Typische Bestandteile (gem. Muster S. 47)","titleAt":384.58,"lead":{"text":"Wie ist sie aufgebaut?","at":383.46},"facts":[{"text":"meistens oben: der Bruttolohn","at":386.24},{"text":"dann alle Abzüge: AHV, ALV, NBU, vielleicht BVG","at":389.1},{"text":"eventuell Zulagen oder Spesen","at":397.14},{"text":"unten: Nettolohn oder ausbezahlter Betrag","at":399.14},{"text":"AHV-pflichtiger Lohn: Basis für die Sozialabgaben","at":412.1},{"text":"entspricht nicht immer genau dem Bruttolohn oder Nettolohn","at":414.3}]},{"at":435.06,"tpl":"map","branch":"Kontoauszug","branchAt":436.06,"title":"Kontoauszug","titleAt":436.06,"facts":[{"text":"alle Eingänge: Gutschriften","at":443.38},{"text":"und Ausgänge: Lastschriften","at":445.02},{"text":"dein aktueller Saldo","at":447.36},{"text":"zur Kontrolle und als Beleg","at":449.34},{"text":"heute meistens elektronisch, ob Papier oder online","at":451.88}]}]},{"title":"Zusammenfassung","shots":[{"at":468.78,"tpl":"map","node":null,"title":"Die Kernpunkte","titleAt":469.78,"facts":[{"text":"der Unterschied: Brutto, Netto, Auszahlung","at":471.8}