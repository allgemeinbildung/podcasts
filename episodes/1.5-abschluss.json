{"id":"1.5-abschluss","title":"1.5 Ökologie im Umfeld – Abschluss","audio":"../allgemeinbildung/audio/1.5%20%C3%96kologie%20im%20Umfeld.wav","duration":419.771,"map":{"root":"Ökologie im Umfeld","branches":[{"label":"Bewusster Konsum","color":"blue","nodes":[{"id":"Ökologische Kriterien","label":"Ökologische Kriterien"},{"id":"Ethische Kriterien","label":"Ethische Kriterien"},{"id":"Produktlabels","label":"Produktlabels"}]},{"label":"Abfallmanagement","color":"green","nodes":[{"id":"Abfallarten in der Schweiz","label":"Abfallarten in der Schweiz"},{"id":"Ursachen für Abfallzunahme","label":"Ursachen für Abfallzunahme"},{"id":"Recyclingpotenzial","label":"Recyclingpotenzial"},{"id":"Recycling","label":"Recycling"},{"id":"Abfallverbrennung (KVA)","label":"Abfallverbrennung (KVA)"},{"id":"Littering","label":"Littering"},{"id":"Gesetzliche Grundlagen & Lösungsansätze","label":"Gesetzliche Grundlagen & Lösungsansätze"}]}]},"chapters":[{"title":"Einstieg","shots":[{"at":0,"tpl":"statement","lines":[{"style":"small","text":"Kapitel 1.5 · Abschluss"},{"style":"big","text":"Ökologie im Umfeld"},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":1.76},{"style":"strip","color":"yellow","text":"Hol deine Mindmap hervor!","at":29.58}]}]},{"title":"Bewusster Konsum","shots":[{"at":50.42,"tpl":"map","node":"Ökologische Kriterien","branchAt":51.42,"title":"Ökologische Kriterien","titleAt":62.94,"lead":{"text":"Entscheidende Kriterien?","at":53.18},"facts":[{"text":"wie umweltfreundlich produziert wird","at":64.36},{"text":"Stichworte: biologisch, nachhaltig","at":67.88}]},{"at":69.74,"tpl":"map","node":"Ethische Kriterien","title":"Ethische Kriterien","titleAt":70.54,"facts":[{"text":"unter welchen Bedingungen für die Menschen","at":72.8},{"text":"faire Löhne, gute Arbeitsbedingungen","at":74.76}]},{"at":77.12,"tpl":"map","node":"Produktlabels","title":"Produktlabels","titleAt":78.12,"facts":[{"text":"z. B. Bio, Fairtrade","at":79.82},{"text":"sollen Orientierung bieten","at":82.66}]},{"at":94.94,"tpl":"map","node":"Ethische Kriterien","sub":true,"title":"Fairtrade","titleAt":95.94,"facts":[{"text":"ein besserer Preis für die Produzenten","at":105.86},{"text":"oft in Entwicklungsländern","at":108.46},{"text":"vor allem die Stabilität der Preise","at":111.12},{"text":"schützt vor Schwankungen am Weltmarkt","at":116.44},{"text":"Auflagen: Umwelt- und Sozialstandards einhalten","at":119.62},{"text":"z. B. die Max-Havelaar-Stiftung","at":123.78}]}]},{"title":"Abfallmanagement","shots":[{"at":136.14,"tpl":"map","node":"Ursachen für Abfallzunahme","branchAt":137.14,"title":"Ursachen für Abfallzunahme","titleAt":138.8,"facts":[{"text":"die Schweiz produziert enorme Mengen Siedlungsabfall","at":138.8},{"text":"viel Verbrauch, viele Verpackungen, gerade Kunststoff","at":148.7}]},{"at":154.94,"tpl":"map","node":"Recyclingpotenzial","title":"Recyclingpotenzial","titleAt":155.94,"facts":[{"text":"wenn wir konsequenter trennen würden …","at":158.04},{"text":"… könnte ein beachtlicher Teil vermieden oder recycelt werden","at":160.38}]},{"at":171.74,"tpl":"map","node":"Recycling","title":"Recycling","titleAt":172.74,"facts":[{"text":"oft technisch ziemlich aufwendig und teuer","at":184.22},{"text":"gerade bei Kunststoffen komplex","at":189.62},{"text":"so viele verschiedene Sorten","at":191.42},{"text":"für sinnvolles Recycling sauber getrennt nötig","at":195.6},{"text":"unterschiedliche chemische Zusammensetzungen, Schmelzpunkte","at":197.22},{"text":"nicht immer wirtschaftlich rentabel","at":202.34}]},{"at":210.92,"tpl":"map","node":"Abfallverbrennung (KVA)","title":"Abfallverbrennung (KVA)","titleAt":216.8,"lead":{"text":"Was passiert mit dem Rest?","at":211.72},"facts":[{"text":"landet in Kehrichtverbrennungsanlagen (KVA)","at":220.98},{"text":"zwei Hauptaufgaben: Schadstoffe unschädlich machen","at":226.52},{"text":"und Energie erzeugen","at":228.3},{"text":"rund 2 % der Schweizer Energie kommen aus KVAs","at":234.82},{"text":"Kehrseite: etwa 5 % der Schweizer CO2-Emissionen","at":241.7}]},{"at":256.3,"tpl":"map","node":"Littering","title":"Littering","titleAt":257.3,"facts":[{"text":"achtlos weggeworfener Müll","at":258.68},{"text":"Reinigungskosten: 200 Millionen Franken pro Jahr","at":268.44},{"text":"Verpackungen, Dosen, Zigarettenstummel","at":279.6},{"text":"landen in der Umwelt, nicht im Recycling","at":282.6},{"text":"verschmutzt Böden und Gewässer, schadet Tieren","at":287.54},{"text":"mindert die Lebensqualität für uns alle","at":289.2}]},{"at":301.94,"tpl":"map","node":"Gesetzliche Grundlagen & Lösungsansätze","title":"Gesetzliche Grundlagen & Lösungsansätze","titleAt":302.94,"facts":[{"text":"zentral: Umweltschutzgesetz (USG) von 1983","at":308.12},{"text":"schreibt das Verursacherprinzip fest","at":313.08},{"text":"wer Abfall verursacht, soll die Kosten tragen","at":315.44},{"text":"3-V-Strategie des BAFU: vermeiden, vermindern, verwerten","at":323.48},{"text":"gegen Littering: Bussen, Prävention, Sensibilisierung","at":331.3},{"text":"z. B. die IG saubere Umwelt (IGSU)","at":335.34}]}]},{"title":"Zusammenfassung","shots":[{"at":349,"tpl":"map","node":null,"title":"Die Kernpunkte","titleAt":350,"facts":[{"text":"Labels helfen, sollte man aber kritisch anschauen","at":363.72},{"text":"Recycling ist wichtig, aber komplex","at":371.34},{"text":"Littering kostet uns alle und schadet der Umwelt","at":374.88},{"text":"Politik: Verursacherprinzip und die drei V","at":378.84}]},{"at":401.94,"tpl":"statement","lines":[{"style":"strip","color":"red","text":"Kleine, machbare Schritte im Alltag?","at":402.54},{"style":"chip","color":"yellow","text":"z. B. Verpackungen vermeiden","at":405.74},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":417.2}]}]}],"caps":[[0,3.16,[["Willkommen",0,0.36],["zu",0.36,0.56],["einer",0.56,0.74],["weiteren",0.74,1.14],["Folge",1.14,1.46],["von",1.46,1.76],["Allgemeinbildung,",1.76,3.16]]],[3.5,4