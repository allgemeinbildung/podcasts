nflation","shots":[{"at":65.86,"tpl":"map","node":"Inflation › Definition & Ursachen","branchAt":66.86,"title":"Definition & Ursachen","titleAt":71.18,"lead":{"text":"Was steckt dahinter?","at":68.44},"facts":[{"text":"anhaltender Anstieg des allgemeinen Preisniveaus","at":72.68},{"text":"Geld wird weniger wert, die Kaufkraft sinkt","at":77.48},{"text":"oft: mehr Geld im Umlauf als Waren und Dienstleistungen","at":82.78}]},{"at":97.58,"tpl":"map","node":"Folgen für Private","title":"Folgen für Private","titleAt":101.94,"lead":{"text":"Welche Folgen gibt es?","at":98.18},"facts":[{"text":"Erspartes verliert an Wert","at":103.22},{"text":"Löhne nicht angepasst: der Reallohn sinkt","at":106.12},{"text":"Reallohn: was du dir wirklich leisten kannst","at":110.46}]},{"at":111.24,"tpl":"map","node":"Folgen für Wirtschaft & Staat","title":"Folgen für Wirtschaft & Staat","titleAt":111.84,"facts":[{"text":"Unternehmen: Planung schwierig, Kosten unsicher","at":113.66},{"text":"Staat: Schulden können real an Wert verlieren","at":118.44}]},{"at":121.58,"tpl":"map","node":"Lohn-Preis-Spirale","title":"Lohn-Preis-Spirale","titleAt":122.58,"facts":[{"text":"die Preise steigen","at":123.5},{"text":"Arbeitnehmende fordern höhere Löhne","at":124.84},{"text":"um die Teuerung auszugleichen","at":126.8},{"text":"die Kosten der Unternehmen steigen","at":131.26},{"text":"Unternehmen müssen die Preise vielleicht wieder anheben","at":133.94},{"text":"ein Kreislauf, der sich selbst verstärken kann","at":136.44}]}]},{"title":"Deflation","shots":[{"at":152.44,"tpl":"map","node":"Deflation › Definition & Ursachen","branchAt":153.44,"title":"Definition & Ursachen","titleAt":155.5,"lead":{"text":"Was bedeutet Deflation?","at":154},"facts":[{"text":"Spiegelbild: anhaltender Rückgang der Preise","at":156.74},{"text":"das Geld gewinnt an Wert","at":161.7},{"text":"Ursache kann sein: Angebot wächst schneller als die Geldmenge","at":164.84},{"text":"oder die Nachfrage bricht stark ein","at":168.76}]},{