{"id":"6.3-abschluss","title":"6.3 Gewaltenteilung – Abschluss","audio":"../allgemeinbildung/audio/6.3%20Gewaltenteilung.wav","duration":486.491,"map":{"root":"Gewaltenteilung in der Schweiz","branches":[{"label":"Legislative (Parlament)","color":"blue","nodes":[{"id":"Zusammensetzung (Nationalrat, Ständerat)","label":"Zusammensetzung (Nationalrat, Ständerat)"},{"id":"Legislative (Parlament) › Aufgaben","label":"Aufgaben"},{"id":"Arbeitsweise","label":"Arbeitsweise"},{"id":"Sessionen","label":"Sessionen"},{"id":"Fraktionen","label":"Fraktionen"},{"id":"Kommissionen","label":"Kommissionen"},{"id":"Vereinigte Bundesversammlung","label":"Vereinigte Bundesversammlung"}]},{"label":"Exekutive (Bundesrat)","color":"green","nodes":[{"id":"Zusammensetzung","label":"Zusammensetzung"},{"id":"Wahl","label":"Wahl"},{"id":"Konkordanz","label":"Konkordanz"},{"id":"Exekutive (Bundesrat) › Aufgaben","label":"Aufgaben"},{"id":"Kollegialitätsprinzip","label":"Kollegialitätsprinzip"},{"id":"Bundespräsident/in und Bundeskanzlei","label":"Bundespräsident/in und Bundeskanzlei"},{"id":"Bundesverwaltung + sieben Departemente","label":"Bundesverwaltung + sieben Departemente"}]},{"label":"Judikative (Bundesgericht)","color":"red","nodes":[{"id":"Oberste richterliche Instanz","label":"Oberste richterliche Instanz"},{"id":"Richterlicher Instanzenweg","label":"Richterlicher Instanzenweg"},{"id":"Gerichts- und Prozessarten","label":"Gerichts- und Prozessarten"},{"id":"Strafgericht","label":"Strafgericht"},{"id":"Zivilgericht","label":"Zivilgericht"},{"id":"Verwaltungsgericht","label":"Verwaltungsgericht"}]}]},"chapters":[{"title":"Einstieg","shots":[{"at":0,"tpl":"statement","lines":[{"style":"small","text":"Kapitel 6.3 · Abschluss"},{"style":"big","text":"Gewaltenteilung"},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":2.28},{"style":"strip","color":"yellow","text":"Holt eure Mindmap hervor!","at":19.66}]},{"at":26.76,"tpl":"statement","head":"Die drei Gewalten","lines":[{"style":"chip","color":"blue","text":"Parlament: Legislative","at":28.54},{"style":"chip","color":"green","text":"Bundesrat: Exekutive, Regierung","at":31.34},{"style":"chip","color":"red","text":"Bundesgericht: Judikative","at":34.5}]}]},{"title":"Legislative","shots":[{"at":58.48,"tpl":"map","branch":"Legislative (Parlament)","branchAt":59.48,"title":"Legislative (Parlament)","titleAt":60.08,"facts":[{"text":"das Parlament ist die Bundesversammlung","at":63.42},{"text":"sie macht die Gesetze","at":65.64}]},{"at":67.28,"tpl":"map","node":"Zusammensetzung (Nationalrat, Ständerat)","title":"Zusammensetzung (Nationalrat, Ständerat)","titleAt":68.28,"facts":[{"text":"Nationalrat: vertritt die Bevölkerung, das Volk","at":69.2},{"text":"Ständerat: vertritt die Kantone","at":73.76},{"text":"Zweikammersystem","at":77.22},{"text":"kein Gesetz ohne Zustimmung beider Räte","at":82.84},{"text":"so zählen Volk und Kantone, verschiedene Interessen","at":86.76}]},{"at":89.96,"tpl":"map","node":"Legislative (Parlament) › Aufgaben","title":"Aufgaben","titleAt":92.4,"lead":{"text":"Was macht es sonst noch?","at":90.76},"facts":[{"text":"wählt die Regierung, den Bundesrat","at":97.54},{"text":"wählt die Bundesrichterinnen und Bundesrichter","at":100.38},{"text":"entscheidet über die Staatsausgaben, das Budget","at":102.18},{"text":"kontrolliert die Verwaltung","at":106}]},{"at":116.7,"tpl":"map","node":"Sessionen","title":"Sessionen","titleAt":117.3,"facts":[{"text":"viermal im Jahr trifft sich das ganze Parlament","at":118.42},{"text":"grosse Runden für Debatten und Schlussabstimmungen","at":122.2}]},{"at":133.64,"tpl":"map","node":"Kommissionen","title":"Kommissionen","titleAt":134.24,"facts":[{"text":"Gesetze ausarbeiten und verhandeln","at":135.42},{"text":"meistens in kleineren, spezialisierten Kommissionen","at":139.8},{"text":"danach wieder ins Plenum, zur Session","at":142.48}]}]},{"title":"Exekutive","shots":[{"at":171.46,"tpl":"map","node":"Zusammensetzung","branchAt":176.52,"title":"Zusammensetzung","titleAt":177.08,"lead":{"text":"Wer setzt die Gesetze um?","at":172.26},"facts":[{"text":"der Bundesrat ist unsere Regierung","at":180.62},{"text":"sieben Mitglieder: Bundesrätinnen und Bundesräte","at":181.94}]},{"at":189.54,"tpl":"map","node":"Konkordanz","title":"Konkordanz","titleAt":190.54,"facts":[{"text":"die wichtigsten Parteien sind gemeinsam in der Regierung","at":193.9},{"text":"breite Abstützung statt einer knappen Mehrheit","at":202.58},{"text":"soll für Stabilität sorgen","at":205.26}]},{"at":209.3,"tpl":"map","node":"Kollegialitätsprinzip","title":"Kollegialitätsprinzip","titleAt":210.3,"facts":[{"text":"gemeinsam entscheiden, mit einer Stimme sprechen","at":213.58},{"text":"auch wenn man intern vielleicht anderer Meinung war","at":216.94},{"text":"jedes Mitglied vertritt die Entscheide des Gesamtgremiums","at":223.6},{"text":"stärkt die Regierung","at":226.04}]},{"at":230.56,"tpl":"map","node":"Bundespräsident/in und Bundeskanzlei","title":"Bundespräsident/in und Bundeskanzlei","titleAt":231.16,"facts":[{"text":"leitet die Sitzung","at":238.8},{"text":"repräsentiert","at":239.96},{"text":"keine Richtlinienkompetenz, keine übergeordnete Macht","at":241.88},{"text":"Bundeskanzlei: quasi der Stab des Bundesrats","at":247.32}]},{"at":249.84,"tpl":"map","node":"Bundesverwaltung + sieben Departemente","title":"Bundesverwaltung + sieben Departemente","titleAt":250.84,"facts":[{"text":"die eigentliche Verwaltungsarbeit, die Umsetzung","at":251.86},{"text":"das machen die sieben Departemente","at":253.08}]}]},{"title":"Judikative","shots":[{"at":284.52,"tpl":"map","node":"Oberste richterliche Instanz","branchAt":284.52,"title":"Oberste richterliche Instanz","titleAt":285.82,"facts":[{"text":"die dritte Gewalt: die Rechtsprechung","at":287.14},{"text":"an der Spitze: das Bundesgericht in Lausanne","at":289.12},{"text":"höchste gerichtliche Instanz der Schweiz","at":292.2}]},{"at":295.34,"tpl":"map","node":"R