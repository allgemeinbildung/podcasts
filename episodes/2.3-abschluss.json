,{"text":"Dauerauftrag: für regelmässige Zahlungen","at":92.58},{"text":"z. B. Miete, Handy, Abo","at":94.78}]},{"at":96.84,"tpl":"map","node":"Bankbasierte Zahlungen","sub":true,"title":"LSV","titleAt":97.84,"facts":[{"text":"Lastschriftverfahren, kurz LSV","at":99.18},{"text":"du erlaubst einer Firma, Geld von deinem Konto abzubuchen","at":101.28},{"text":"typisches Beispiel: Krankenkasse","at":104.96}]},{"at":119.74,"tpl":"map","node":"Digitale Bankdienstleistungen","title":"Digitale Bankdienstleistungen","titleAt":120.74,"lead":{"text":"Was gehört dazu?","at":122.82},"facts":[{"text":"Bankgeschäfte online erledigen","at":126.2},{"text":"E-Banking: am Computer oder per App, heute quasi der Standard","at":129.06},{"text":"QR-Rechnung: Bezahlen per Scan","at":134.16},{"text":"eBill: Rechnungen direkt ins E-Banking-Postfach","at":139.24}]},{"at":162.08,"tpl":"map","node":"Kartenbasierte Zahlungen","sub":true,"title":"Debitkarten","titleAt":163.08,"facts":[{"text":"Debit heisst so etwas wie «Soll» oder «Abbuchung»","at":167.26},{"text":"Geld wird sofort oder sehr zeitnah vom Bankkonto abgebucht","at":171.74},{"text":"z. B. Debit Mastercard oder PostFinance Card","at":177.98}]},{"at":189.06,"tpl":"map","node":"Kartenbasierte Zahlungen","sub":true,"title":"Kreditkarten","titleAt":191.08,"lead":{"text":"Anders als die Debitkarte?","at":190.06},"facts":[{"text":"die Bank gibt dir quasi einen kurzfristigen Kredit","at":198.88},{"text":"über den Monat verteilt, am Ende eine gesammelte Rechnung","at":204.22},{"text":"Verschuldungsrisiko: mehr ausgeben, als man hat","at":211.28},{"text":"kontaktloses Bezahlen: mit beiden Kartenarten","at":214.92},{"text":"mögliche Jahresgebühren bei Kreditkarten","at":221.68}]},{"at":226.54,"tpl":"map","node":"Kartenbasierte Zahlungen","title":"Kartenbasierte Zahlungen","titleAt":227.54,"facts":[{"text":"Kundenkarten: oft zum Punkte sammeln","at":234.08},{"text":"sollen dich als Kunden binden","at":236.62},{"text":"du bezahlst oft mit deinen Daten","at":240.04},{"text":"manche haben eine Zahlungsfunktion","at":243.38},{"text":"abwägen: kleiner Rabatt gegen Preisgabe deines Kaufverhaltens","at":249.3},{"text":"fürs Ausland: Travel Prepaid-Karte, wird aufgeladen","at":258.36}]},{"at":270.76,"tpl":"map","node":"Online- & Mobile Zahlungssysteme","sub":true,"title":"PayPal","titleAt":271.76,"facts":[{"text":"quasi eine digitale Geldbörse, eine Art Zwischenhändler","at":275.58},{"text":"Bank- oder Kreditkartendaten einmalig hinterlegen","at":278.76},{"text":"online zahlen nur mit E-Mail-Adresse und Passwort","at":281.8},{"text":"kann sicherer sein, als überall Kartendaten anzugeben","at":286.04}]},{"at":296.98,"tpl":"map","node":"Online- & Mobile Zahlungssysteme","sub":true,"title":"Mobile Zahlungssysteme","titleAt":297.98,"facts":[{"text":"in der Schweiz sehr populär: Twint","at":301.34},{"text":"international: Apple Pay, Google Pay, Samsung Pay","at":304.68},{"text":"direkt mit dem Smartphone im Laden oder online zahlen","at":309}]}]},{"title":"Zusammenfassung","shots":[{"at":322.44,"tpl":"map","node":null,"title":"Die Kernpunkte","titleAt":323.44,"facts":[{"text":"Unterschied zwischen Debit- und Kreditkarte","at":338.72},{"text":"bargeldlos: Sicherheit, Datenschutz, mögliche Gebühren","at":346.04},{"text":"Verschuldungsrisiko ist nicht bei allen gleich gross","at":366.06}]},{"at":368.78,"tpl":"statement","lines":[{"style":"small","text":"Lernziele","at":369.38},{"style":"chip","color":"green","text":"die Zahlungsarten kennen","at":371.54},{"style":"chip","color":"green","text":"ihre Funktionsweise verstehen","at":373.02},{"style":"chip","color":"green","text":"Vor- und Nachteile einschätzen","at":376.76},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":390.82}]}]}],"caps":[[0,3.34,[["Willkommen",0,0.48],["zu",0.48,0.84],["einer",0.84,1.16],["weiteren",1.16,1.68],["Folge",1.68,2.02],["von",2.02,2.32],["Allgemeinbildung,",2.32,3.34]]],[3.52,5.72,[["das",3.52,3.98