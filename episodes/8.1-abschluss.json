{"id":"8.1-abschluss","title":"8.1 Kaufvertragsarten Teil 2 – Abschluss","audio":"../allgemeinbildung/audio/8.1%20Kaufvertragsarten%20Teil%202.wav","duration":399.731,"map":{"root":"Kaufvertragsarten Teil 2","branches":[{"label":"Leasing","color":"blue","nodes":[{"id":"Definition & Eigentum","label":"Definition & Eigentum"},{"id":"Rechtliches (KKG)","label":"Rechtliches (KKG)"},{"id":"Kosten & Risiken","label":"Kosten & Risiken"}]},{"label":"Miet-Kauf-Vertrag","color":"green","nodes":[{"id":"Funktionsweise & Eigentum","label":"Funktionsweise & Eigentum"},{"id":"Rechtliches","label":"Rechtliches"}]},{"label":"Kauf mit Konsumkreditvertrag","color":"red","nodes":[{"id":"KKG-Schutzbestimmungen","label":"KKG-Schutzbestimmungen"},{"id":"Vertragsdetails & Eigentum","label":"Vertragsdetails & Eigentum"}]},{"label":"Kauf mit Kleindarlehen","color":"yellow","nodes":[{"id":"Merkmale & Eigentum","label":"Merkmale & Eigentum"},{"id":"KKG & Kosten","label":"KKG & Kosten"}]}]},"chapters":[{"title":"Einstieg","shots":[{"at":0,"tpl":"statement","lines":[{"style":"small","text":"Kapitel 8.1 · Abschluss"},{"style":"big","text":"Kaufvertragsarten Teil 2"},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":2.12},{"style":"strip","color":"yellow","text":"Hol deine Mindmap hervor!","at":19.88}]}]},{"title":"Leasing","shots":[{"at":54.82,"tpl":"map","node":"Definition & Eigentum","branchAt":55.82,"title":"Definition & Eigentum","titleAt":57.88,"facts":[{"text":"klassisches Beispiel: das Auto","at":59.6},{"text":"du kriegst eine Sache zur Nutzung und zahlst Raten","at":63.28},{"text":"sie gehört dir nicht: du bist nur Nutzer","at":66.16}]},{"at":69.4,"tpl":"map","node":"Rechtliches (KKG)","title":"Rechtliches (KKG)","titleAt":70.4,"facts":[{"text":"oft ein 14-tägiges Rücktrittsrecht","at":71.18},{"text":"wenn das Leasing unter das KKG fällt","at":73.12},{"text":"KKG: Konsumkreditgesetz","at":76.36},{"text":"wenn das KKG greift, muss der Vertrag schriftlich sein","at":86.7},{"text":"wichtige Infos: Barkaufpreis, Raten, effektiver Jahreszins","at":90.78}]},{"at":95.84,"tpl":"map","node":"Rechtliches (KKG)","sub":true,"title":"Bonitätsprüfung","titleAt":97.32,"facts":[{"text":"obligatorisch, wenn das KKG greift","at":97.92},{"text":"der Anbieter muss checken, ob du dir das leisten kannst","at":99.36}]},{"at":102.8,"tpl":"map","node":"Rechtliches (KKG)","sub":true,"title":"Rolle der IKO","titleAt":103.8,"facts":[{"text":"der Vertrag wird der IKO gemeldet","at":104.16},{"text":"Informationsstelle für Konsumkredit","at":104.96},{"text":"Schutz vor Überschuldung","at":107.96}]},{"at":108.96,"tpl":"map","node":"Kosten & Risiken","title":"Kosten & Risiken","titleAt":109.96,"lead":{"text":"Nur die Rate?","at":111.04},"facts":[{"text":"die Rate deckt vor allem Wertverlust und Zinsen","at":114.14},{"text":"dazu oft Versicherungen, Service, mehr Kilometer","at":117.7},{"text":"früher aus dem Vertrag raus kann richtig teuer werden","at":123.02}]}]},{"title":"Miet-Kauf","shots":[{"at":145.76,"tpl":"map","node":"Funktionsweise & Eigentum","branchAt":147.64,"title":"Funktionsweise & Eigentum","titleAt":153.18,"lead":{"text":"Was ist der Mietkauf?","at":146.56},"facts":[{"text":"eine Mischform","at":154.78},{"text":"manchmal «unechtes Leasing» genannt","at":156.7},{"text":"du mietest und hast später die Option, zu kaufen","at":159.42},{"text":"gezahlte Mieten werden oft angerechnet","at":164.68},{"text":"während du mietest, gehört dir die Sache nicht","at":167.64}]},{"at":168.58,"tpl":"map","node":"Rechtliches","title":"Rechtliches","titleAt":169.58,"facts":[{"text":"kein gesetzliches 14-tägiges Rücktrittsrecht","at":172.9},{"text":"anders als oft beim Leasing mit KKG","at":176.1},{"text":"der Vertragstyp ist generell weniger klar geregelt","at":178.92}]}]},{"title":"Konsumkredit","shots":[{"at":188.44,"tpl":"map","branch":"Kauf mit Konsumkreditvertrag","branchAt":189.44,"title":"Kauf mit Konsumkreditvertrag","titleAt":189.44,"facts":[{"text":"du zahlst vielleicht etwas an","at":196.1},{"text":"du kriegst die Ware sofort","at":197.98},{"text":"den Rest stotterst du in Raten ab","at":198.94},{"text":"KKG gilt meist je nach Betrag, bei Laufzeit über drei Monaten","at":204.74}]},{"at":210.48,"tpl":"map","node":"Vertragsdetails & Eigentum","title":"Vertragsdetails & Eigentum","titleAt":211.48,"facts":[{"text":"du wirst normalerweise sofort Eigentümer der Ware","at":211.78},{"text":"anders als beim Leasing","at":213.86}]},{"at":216.2,"tpl":"map","node":"Vertragsdetails & Eigentum","sub":true,"title":"Eigentumsvorbehalt (gem. ZGB Art. 715f)","titleAt":217.2,"facts":[{"text":"wird vereinbart und im Register eingetragen","at":219.94},{"text":"eher die Ausnahme","at":222.54}]},{"at":230.5,"tpl":"map","node":"Vertragsdetails & Eigentum","sub":true,"title":"Notwendige Vertragsinhalte (gem. KKG Art. 9, 10)","titleAt":231.5,"facts":[{"text":"alles muss schriftlich sein","at":232.08},{"text":"Pflichtangaben: Barzahlungspreis, Gesamtkosten des Kredits","at":233.54}]},{"at":239.56,"tpl":"map","node":"KKG-Schutzbestimmungen","title":"KKG-Schutzbestimmungen","titleAt":240.56,"facts":[{"text":"14 Tage Rücktrittsrecht","at":241.14},{"text":"Meldung an die IKO","at":242.3},{"text":"obligatorische Kreditfähigkeitsprüfung","at":243.98},{"text":"Kreditgeber prüft: wahrscheinlich Rückzahlung in 36 Monaten?","at":250.36},{"text":"ohne dich finanziell zu übernehmen","at":252.72}]}]},{"title":"Kleindarlehen","shots":[{"at":266.66,"tpl":"map","node":"Merkmale & Eigentum","branchAt":267.66,"title":"Merkmale & Eigentum","titleAt":273.92,"lead":{"text":"Dasselbe wie Konsumkredit?","at":269.3},"facts":[{"text":"auch Barkredit genannt","at":275.04},{"text":"du leihst dir Geld von einer Bank, um bar zu bezahlen","at":276.36},{"text":"du zahlst bar und wirst sofort Eigentümer der Ware","at":285.72},{"text":"deine Schulden hast du bei der Bank, nicht beim Verkäufer","at":288.26}]},{"at":296.02,"tpl":"map","node":"KKG & Kosten","sub":true,"title":"Hohe Zinsen","titleAt":307.96,"lead":{"text":"Spezielle Haken?","at":296.82},"facts":[{"text":"Banken brauchen oft keine Extrasicherheiten","at":301.36},{"text":"ein Lohnnachweis reicht meist","at":303.04},{"text":"das Risiko für die Bank ist dadurch höher","at":305.3},{"text":"bis zu 10 %","at":310.84}]},{"at":314.06,"tpl":"map","node":"KKG & Kosten","title":"KKG & Kosten","titleAt":315.06,"facts":[{"text":"Schriftform und Inhaltsvorschriften","at":315.86},{"text":"14 Tage Rücktrittsrecht","at":318.12},{"text":"Kreditfähigkeitsprüfung","at":320.52},{"text":"Möglichkeit, vorzeitig zurückzuzahlen","at":321.8}]}]},{"title":"Zusammenfassung","shots":[{"at":335.54,"tpl":"map","node":null,"title":"Die Kernpunkte","titleAt":336.54,"facts":[{"text":"KKG schützt: Rücktrittsrecht, Prüfung der Kreditfähigkeit","at":340.98},{"text":"es gilt nicht immer, siehe Mietkauf","at":346.34},{"text":"genau auf die Gesamtkosten im Vertrag schauen","at":350.1}]},{"at":375,"tpl":"statement","lines":[{"style":"strip","color":"yellow","text":"Tipp: eine Nacht drüber schlafen","at":375.6},{"style":"chip","color":"blue","text":"neutrale Stellen, Konsumentenschutz","at":379.72},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":396.84}]}]}],"caps":[[0,3.22,[["Willkommen",0,0.42],["zu",0.42,0.66],["einer",0.66,0.9],["weiteren",0.9,1.42],["Folge",1.42,1.76],["von",1.76,2.12],["Allgemeinbildung,",2.12,3.22]]],[3.44,5.18,[["das",3.44,3.66],["Lehrmittel",3.66,4.2],["anders",4.2,4.56],["erzählt.",4.56,5.18]]],[5.62,7.82,[["Heute",5.62,6.18],["geht",6.18,6.36],["es",6.36,6.42],["weiter",6.42,6.64],["mit",6.64,6.76],["den",6.76,6.88],["Kaufvertragsarten.",6.88,7.82]]],[8.04,13.4,[["Wir",8.04,8.56],["schauen",8.56,9.1],["uns",9.1,9.26],["Finanzierungsformen",9.26,10.3],["an,",10.3,10.5],["die",10.96,11.16],["gerade",11.16,12.24],["am",12.24,12.46],["Anfang",12.46,12.72],["relevant",12.72,13.06],["werden",13.06,13.4]]],[13.4,17.54,[["könn