{"id":"2.2-abschluss","title":"2.2 Budget – Abschluss","audio":"../allgemeinbildung/audio/2.2%20Budget.wav","duration":355.611,"map":{"root":"Mein Budget","branches":[{"label":"Warum ein Budget?","color":"blue","nodes":[]},{"label":"Budgeterstellung","color":"green","nodes":[{"id":"Merkpunkte","label":"Merkpunkte"},{"id":"Schritte der Erstellung","label":"Schritte der Erstellung"}]},{"label":"Umgang mit Schulden","color":"red","nodes":[{"id":"Erste Schritte bei Schulden","label":"Erste Schritte bei Schulden"},{"id":"Warnsignale","label":"Warnsignale"},{"id":"Hilfsangebote","label":"Hilfsangebote"}]},{"label":"Budgetkontrolle","color":"yellow","nodes":[{"id":"Ausgabenkontrolle","label":"Ausgabenkontrolle"},{"id":"Saldo","label":"Saldo"}]}]},"chapters":[{"title":"Einstieg","shots":[{"at":0,"tpl":"statement","lines":[{"style":"small","text":"Kapitel 2.2 · Abschluss"},{"style":"big","text":"Budget"},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":2},{"style":"strip","color":"yellow","text":"Hol deine Mindmap hervor!","at":16.86}]}]},{"title":"Warum ein Budget","shots":[{"at":60.72,"tpl":"map","branch":"Warum ein Budget?","branchAt":61.72,"title":"Warum ein Budget?","titleAt":61.72,"facts":[{"text":"klarer Überblick über Einnahmen und Ausgaben","at":67.94},{"text":"das Geld bewusst einsetzen","at":72.28}]}]},{"title":"Budgeterstellung","shots":[{"at":74,"tpl":"map","node":"Merkpunkte","branchAt":75,"title":"Merkpunkte","titleAt":75,"facts":[{"text":"realistisch bleiben","at":77.36},{"text":"ehrlich zu sich selbst sein","at":78.76},{"text":"es braucht Disziplin","at":82.08}]},{"at":94.78,"tpl":"map","node":"Schritte der Erstellung","title":"Schritte der Erstellung","titleAt":95.78,"facts":[{"text":"zuerst die Einnahmen erfassen","at":98.44},{"text":"dann die fixen Kosten","at":100.44},{"text":"erst danach die variablen Kosten","at":102.52}]},{"at":112.48,"tpl":"map","node":"Schritte der Erstellung","sub":true,"title":"Fixe Kosten","titleAt":113.48,"facts":[{"text":"regelmässige Ausgaben, oft schwer zu ändern","at":116},{"text":"z. B. Miete, Krankenkasse, vielleicht Handy, Streaming-Abos","at":120.38},{"text":"fest einplanen","at":129.52},{"text":"müssen gedeckt sein, bevor du den Rest ausgibst","at":138.78}]},{"at":146.64,"tpl":"map","node":"Schritte der Erstellung","sub":true,"title":"Variable Kosten","titleAt":147.64,"facts":[{"text":"z. B. Essen und Trinken unterwegs, Kleidung, Hobbys, Ausgehen","at":155.34},{"text":"nicht jeden Monat gleich: dein Verhalten bestimmt den Betrag","at":163.62},{"text":"oft das grösste Sparpotenzial","at":166.72},{"text":"aber auch die grösste Gefahr, das Budget zu sprengen","at":169.6},{"text":"was ist wirklich nötig, was eher Luxus?","at":182.72}]},{"at":190.44,"tpl":"map","node":"Schritte der Erstellung","sub":true,"title":"Einnahmen","titleAt":191.44,"facts":[{"text":"dein Lohn, vielleicht Nebenverdienste oder Zuschüsse","at":192.54},{"text":"müssen auch erfasst werden","at":196.18}]},{"at":199.5,"tpl":"map","node":"Schritte der Erstellung","sub":true,"title":"Rückstellungen","titleAt":200.5,"facts":[{"text":"Geld zur Seite legen","at":202.14},{"text":"für Ausgaben, die nicht monatlich, aber planbar anfallen","at":204.56},{"text":"z. B. Zahnarzt oder Jahresrechnung vom Fitness-Abo","at":207.48}]}]},{"title":"Budgetkontrolle","shots":[{"at":213.3,"tpl":"map","node":"Saldo","branchAt":214.3,"title":"Saldo","titleAt":221.58,"facts":[{"text":"Einnahmen minus alle Ausgaben, inklusive Rückstellungen","at":221.88},{"text":"zeigt, was am Monatsende übrig bleibt","at":222.18}]},{"at":230.44,"tpl":"map","node":"Ausgabenkontrolle","title":"Ausgabenkontrolle","titleAt":231.44,"facts":[{"text":"zeigt, ob Plan und Realität übereinstimmen","at":238.28},{"text":"und wo du vielleicht nachjustieren musst","at":240.26}]}]},{"title":"Umgang mit Schulden","shots":[{"at":240.94,"tpl":"map","node":"Erste Schritte bei Schulden","branchAt":246.44,"title":"Erste Schritte bei S