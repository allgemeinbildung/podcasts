{"id":"5.2-abschluss","title":"5.2 Haftpflichtversicherungen – Abschluss","audio":"../allgemeinbildung/audio/5.2%20Haftpflichtversicherungen.wav","duration":431.651,"map":{"root":"Haftpflichtversicherungen","branches":[{"label":"Grundlagen der Haftpflicht","color":"blue","nodes":[{"id":"Haftungsprinzip (OR Art. 41)","label":"Haftungsprinzip (OR Art. 41)"},{"id":"Erstperson","label":"Erstperson"},{"id":"Zweitperson","label":"Zweitperson"},{"id":"Drittperson","label":"Drittperson"}]},{"label":"Motorfahrzeughaftpflicht","color":"green","nodes":[{"id":"Obligatorium (SVG Art. 63)","label":"Obligatorium (SVG Art. 63)"},{"id":"Selbstbehalte (Jung-/Neu-/übrige Lenker)","label":"Selbstbehalte (Jung-/Neu-/übrige Lenker)"},{"id":"Grobfahrlässigkeit + Regress","label":"Grobfahrlässigkeit + Regress"},{"id":"Bonus-Malus-System / Bonusschutz","label":"Bonus-Malus-System / Bonusschutz"}]},{"label":"Privathaftpflicht","color":"red","nodes":[{"id":"Grundprinzip","label":"Grundprinzip"},{"id":"Verschuldenshaftung + Beispiel","label":"Verschuldenshaftung + Beispiel"},{"id":"Kausalhaftung - Arten + Beispielen","label":"Kausalhaftung - Arten + Beispielen"},{"id":"Empfehlung/Drohnen","label":"Empfehlung/Drohnen"}]}]},"chapters":[{"title":"Einstieg","shots":[{"at":0,"tpl":"statement","lines":[{"style":"small","text":"Kapitel 5.2 · Abschluss"},{"style":"big","text":"Haftpflichtversicherungen"},{"style":"chip","color":"blue","text":"Allgemeinbildung – das Lehrmittel anders erzählt","at":1.8},{"style":"strip","color":"yellow","text":"Holt eure Mindmap hervor!","at":15.98}]},{"at":22.3,"tpl":"statement","lines":[{"style":"chip","color":"blue","text":"Haften: wer ist wer?","at":23.1},{"style":"chip","color":"green","text":"Motorfahrzeughaftpflicht","at":27.8},{"style":"chip","color":"red","text":"Privathaftpflicht","at":31.48}]}]},{"title":"Grundlagen","shots":[{"at":55.5,"tpl":"map","node":"Haftungsprinzip (OR Art. 41)","branchAt":58.04,"title":"Haftungsprinzip (OR Art. 41)","titleAt":66.84,"lead":{"text":"Was heisst haften?","at":56.3},"facts":[{"text":"wer anderen Schaden zufügt, muss dafür geradestehen","at":73.58},{"text":"Versicherung übernimmt Kosten für Schäden an Drittpersonen","at":84.46}]},{"at":96.08,"tpl":"map","node":"Zweitperson","title":"Zweitperson","titleAt":97.08,"facts":[{"text":"normalerweise deine Familie im gleichen Haushalt","at":100.06},{"text":"wichtig für die Privathaftpflicht","at":103.72}]},{"at":106.46,"tpl":"map","node":"Drittperson","title":"Drittperson","titleAt":107.46,"facts":[{"text":"Schäden an ihnen oder ihren Sachen sind gedeckt","at":112.32}]}]},{"title":"Motorfahrzeug","shots":[{"at":124.32,"tpl":"map","node":"Obligatorium (SVG Art. 63)","branchAt":124.32,"title":"Obligatorium (SVG Art. 63)","titleAt":125.32,"facts":[{"text":"ohne sie kein Nummernschild für Auto oder Motorrad","at":127.86},{"text":"deckt Personen- und Sachschäden bei anderen","at":132.02},{"text":"nicht am eigenen Auto","at":136.14}]},{"at":141.28,"tpl":"map","node":"Selbstbehalte (Jung-/Neu-/übrige Lenker)","title":"Selbstbehalte (Jung-/Neu-/übrige Lenker)","titleAt":142.28,"facts":[{"text":"der Teil, den du bei einem Schaden selbst zahlst","at":143.84},{"text":"für Jung- und Neulenker oft höher","at":148.02}]},{"at":152.24,"tpl":"map","node":"Grobfahrlässigkeit + Regress","title":"Grobfahrlässigkeit + Regress","titleAt":153.24,"facts":[{"text":"Versicherung zahlt zuerst den Schaden beim Opfer","at":159.7},{"text":"holt sich das Geld teilweise von dir zurück","at":162.86},{"text":"vor allem bei Grobfahrlässigkeit","at":166.46},{"text":"z. B. Alkohol, Drogen oder massiv zu schnelles Fahren","at":169}]},{"at":186.18,"tpl":"map","node":"Bonus-Malus-System / Bonusschutz","title":"Bonus-Malus-System / Bonusschutz","titleAt":186.98,"facts":[{"text":"unfallfrei: Prämie wird günstiger (Bonus)","at":190.64},{"text":"Schäden verursacht: Prämie wird teurer (Malus)","at":195.86},{"text":"Bonusschutz: oft möglich, kostet extra","at":203.84},{"text":"verhindert den sofortigen Prämienanstieg nach einem Schaden","at":205.42}]}]},{"title":"Privathaftpflicht","shots":[{"at":218.34,"tpl":"map","node":"Grundprinzip","branchAt":219.14,"title":"Grundprinzip","titleAt":219.14,"lead":{"text":"Schäden ohne Auto?","at":219.14},"facts":[{"text":"z. B. Fensterscheibe des Nachbarn eingeworfen","at":224.8},{"text":"deckt Schäden, die du als Privatperson anderen zufügst","at":230.72}]},{"at":233.1,"tpl":"map","node":"Empfehlung/Drohnen","title":"Empfehlung/Drohnen","titleAt":234.88,"lead":{"text":"Auch Pflicht?","at":233.9},"facts":[{"text":"gesetzlich keine Pflicht","at":235.6},{"text":"aber empfehlenswert","at":237.3},{"text":"viele Vermieter verlangen sie vor der Wohnungsmiete","at":240.84}]},{"at":254.56,"tpl":"map","node":"Verschuldenshaftung + Beispiel","title":"Verschuldenshaftung + Beispiel","titleAt":255.56,"facts":[{"text":"du bist direkt schuld","at":259.02},{"text":"du machst aktiv etwas falsch, bist unvorsichtig","at":260.94},{"text":"z. B. Fussball und die Scheibe des Nachbarn","at":267.52}]},{"at":269.8,"tpl":"map","node":"Kausalhaftung - Arten + Beispielen","title":"Kausalhaftung - Arten + Beispielen","titleAt":270.6,"facts":[{"text":"auch ohne eigene Schuld haftbar","at":278.98},{"text":"wegen deiner Rolle oder Verantwortung","at":285.16},{"text":"Eltern für minderjährige Kinder (ZGB Art. 333)","at":294.22},{"text":"Tierhalter für ihre Tiere (OR Art. 56)","at":297.88},{"text":"Hauseigentümer für Mängel am Gebäude (OR Art. 58)","at":315.04},{"text":"Arbeitgeber für Fehler ihrer Angestellten (OR Art. 55)","at":318.78}]},{"at":325.12,"tpl":"map","node":"Empfehlung/Drohnen","title":"Empfehlung/Drohnen","titleAt":326.12,"facts":[{"text":"private Drohnen: oft Kausalhaftung","at":326.56},{"text":"Privathaftpflicht deckt auch diese Haftung","at":336.88}]}]},{"title":"Zusammenfassung","shots":[{"at":349.56,"tpl":"map","node":null,"title":"Die Kernpunkte","titleAt":350.16,"facts":[{"text":"Haftpflicht: gegen Forderungen, wenn du an