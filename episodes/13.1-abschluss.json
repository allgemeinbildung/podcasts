chip","color":"green","text":"Berufliche Vorsorge","at":28.82},{"style":"chip","color":"red","text":"Private Vorsorge","at":29.88}]},{"at":57.04,"tpl":"statement","lines":[{"style":"strip","color":"red","text":"Was ist die Grundidee?","at":57.64},{"style":"chip","text":"Aufteilung der Verantwortung","at":62.52},{"style":"chip","text":"Aufteilung der Ziele","at":63.86}]},{"at":65,"tpl":"map","node":"Hauptzweck (Existenzsicherung)","branchAt":65.24,"title":"Hauptzweck (Existenzsicherung)","titleAt":67.96,"facts":[{"text":"das Nötigste","at":70.5}]},{"at":71.52,"tpl":"map","node":"Hauptzweck (Fortsetzung Lebensstandard)","branchAt":72.12,"title":"Hauptzweck (Fortsetzung Lebensstandard)","titleAt":74.36,"facts":[{"text":"soll zusammen mit der 1. Säule helfen","at":75.02}]},{"at":81.22,"tpl":"map","node":"Hauptzweck (individuelle Ergänzungen)","branchAt":81.8,"title":"Hauptzweck (individuelle Ergänzungen)","titleAt":83.96,"facts":[{"text":"alles, was darüber hinausgeht","at":86.06}]}]},{"title":"Staatliche Vorsorge","shots":[{"at":101.36,"tpl":"map","node":"AHV","title":"AHV","titleAt":101.96,"facts":[{"text":"Alters- und Hinterlassenenversicherung","at":105.94},{"text":"obligatorisch für praktisch alle","at":111.22},{"text":"sichert das Existenzminimum im Alter","at":113.96},{"text":"auch für Hinterbliebene, falls jemand stirbt","at":116.28}]},{"at":118.46,"tpl":"map","node":"AHV","sub":true,"title":"Finanzierung (Umlageverfahren, Staatsbeiträge)","titleAt":119.92,"lead":{"text":"Was heisst das?","at":129.52},"facts":[{"text":"Beiträge der Arbeitenden zahlen die aktuellen Renten","at":133.36},{"text":"ein Generationenvertrag","at":142.32}],"note":{"text":"Umlageverfahren mit AHV verknüpfen","at":127.24}},{"at":154.62,"tpl":"map","node":"AHV","sub":true,"title":"Zentrale Herausforderungen (Demografie)","titleAt":155.62,"facts":[{"text":"immer mehr Rentnerinnen und Rentner finanzieren","at":158.28}]},{"at":177.6,"tpl":"map","node":"IV","title":"IV","titleAt":178.2,"facts":[{"text":"Invalidenversicherung","at":179.32}]},{"at":184.2,"tpl":"map","node":"IV","sub":true,"title":"Grundsatz «Eingliederung vor Rente»","titleAt":186.14,"facts":[{"text":"zuerst alles versuchen, damit jemand wieder arbeiten kann","at":188.52}],"note":{"text":"Unter «IV»: Eingliederung vor Rente","at":193.5}},{"at":199.9,"tpl":"map","node":"ALV","title":"ALV","titleAt":200.5,"facts":[{"text":"Arbeitslosenversicherung","at":201.66},{"text":"hilft finanziell, wenn man den Job verliert","at":203.58},{"text":"unterstützt bei der Stellensuche","at":206.16},{"text":"über das RAV: regionale Arbeitsvermittlungszentren","at":208.62}]},{"at":211.36,"tpl":"map","node":"EO","title":"EO","titleAt":211.96,"facts":[{"text":"Erwerbsersatzordnung","at":212.84},{"text":"springt ein bei Militär- oder Zivildienst","at":214.82},{"text":"deckt Mutterschafts- und Vaterschaftsentschädigung ab","at":219.84}]}]},{"title":"Berufliche Vorsorge","shots":[{"at":241.46,"tpl":"map","node":"Pensionskasse (BVG)","title":"Pensionskasse (BVG)","titleAt":242.46,"facts":[{"text":"soll zusammen mit der AHV den gewohnten Lebensstandard sichern","at":246.02},{"text":"obligatorisch für Arbeitnehmende ab einem bestimmten Lohn","at":252.32},{"text":"nicht für alle, aber für viele","at":255.9}]},{"at":259,"tpl":"map","node":"Pensionskasse (BVG)","sub":true,"title":"Finanzierungsprinzip (Kapitaldeckungsverfahren)","titleAt":260.66,"lead":{"text":"Was heisst das konkret?","at":271.6},"facts":[{"text":"Gegenstück zum Umlageverfahren der AHV","at":265.1},{"text":"jede Person spart ihr eigenes Alterskapital","at":274.38},{"text":"Beiträge beider auf persönlichem Konto","at":280.1},{"text":"angelegt, später Rente oder teils Kapital","at":287.66},{"text":"nicht direkt für die heutigen Rentner","at":300.52}],"note":{"text":"Kapitaldeckungsverfahren beim 2. Ast","at":269.68}}]},{"title":"Private Vorsorge","shots":[{"at":313.6,"tpl":"map","node":"Verantwortung (Eigenverantwortung)","title":"Verantwortung (Eigenverantwortung)","titleAt":314.2,"facts":[{"text":"der Bereich, den man selbst gestalten kann","at":317.2},{"text":"um zusätzliche Wünsche zu erfüllen","at":319.08},{"text":"vielleicht auch Vorsorgelücken der 1. und 2. Säule schliessen","at":322.12}]},{"at":330.48,"tpl":"map","node":"Säule 3a (gebundene Vorsorge)","title":"Säule 3a (gebundene Vorsorge)","titleAt":331.28,"lead":{"text":"Wo liegt der Unterschied?","at":334.62},"facts":[{"text":"gebunden: Geld erstmal blockiert bis zur Pensionierung","at":338.62},{"text":"jährliche Einzahlung bis zum gesetzlichen Maximalbetrag","at":346.52},{"text":"vom steuerbaren Einkommen abziehbar: spart Steuern","at":349.96},{"text":"Bezug nur in wenigen Ausnahmen","at":358.12},{"text":"z. B. Kauf von Wohneigentum","at":360.46}]},{"at":363,"tpl":"map","node":"Säule 3b (freie Vorsorge)","title":"Säule 3b (freie Vorsorge)","titleAt":363.6,"facts":[{"text":"z. B. Sparkonto, Aktien, Lebensversicherung","at":367.12},{"text":"völlig flexibel, jederzeit Zugriff aufs Geld","at":371.82},{"text":"keine direkten Steuervorteile bei der Einzahlung","at":376.14}],"note":{"text":"3a gebunden, 3b frei, flexibel","at":380.3}}]},{"title":"Zusammenfassung","shots":[{"at":393.86,"tpl":"map","node":null,"title":"Die Kernpunkte","titleAt":395.06,"facts":[{"text":"Drei-Säulen-Prinzip als Basis","at":401.34},{"text":"AHV: Umlageverfahren","at":407.32},{"text":"Pensionskasse: Kapitaldeckungsverfahren","at":411.54},{"text":"IV: Eingliederung vor Rente","at":416.76},{"text":"3. Säule: individuelle Vorsorge, Steueranreize der 3a","at":422.9},{"text":"AHV: demografische Herausforderung","at":430.58}]},{"at":438.08,"tpl":"statement","head":"Lernziel: erklären können","lines":[{"style":"chip","color":"green","text":"Grundzüge der Schweizer Altersvorsorge","at":438.68}]},{"at":452.42,"tpl":"statement","lines":[{"style":"chip","color":"yellow","text":"Maximalbeträge der Säule 3a","at":453.02},{"style":"chip","color":"yellow","text":"Reformen in der Diskussion","at":45